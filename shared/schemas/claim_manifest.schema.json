{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/943fansi/evidence-suite/blob/main/shared/schemas/claim_manifest.schema.json",
  "title": "Evidence Manifest (claim-centric)",
  "description": "claim-centric 互操作契约：由 finalize_draft.py --claim-manifest 产出，研究 Agent 只需产出 claim→evidence→verdict 结构即可被 Reviewer / 终审门消费。",
  "type": "object",
  "required": ["schema_version", "review_kind", "verification_mode", "finalized_at", "claims"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "manifest 契约版本；字段变更时必须递增，旧版解析器据此拒绝而非静默误读。"
    },
    "review_kind": {
      "type": "string",
      "enum": ["ai-internal", "ai-cross-model", "human-expert"],
      "description": "审查类型：ai-internal=同模型角色隔离（内部红队，不等同独立评审）；ai-cross-model=不同模型独立审查；human-expert=人类专家评审。"
    },
    "review_independence": {
      "type": "object",
      "description": "审查独立性细节：跨模型（ai-cross-model）也不等于独立——若两者共享相同检索结果/系统提示/reasoning prior，错误仍高度相关。如实记录以便下游判断 correlated failure 风险。",
      "properties": {
        "reviewer_model": { "type": "string" },
        "writer_model": { "type": "string" },
        "model_family": { "type": "string" },
        "context_shared": { "type": "boolean" },
        "evidence_shared": { "type": "boolean" },
        "human_involvement": { "type": "string", "enum": ["none", "partial", "full"] }
      }
    },
    "verification_mode": {
      "type": "string",
      "enum": ["static", "live"]
    },
    "finalized_at": {
      "type": "string",
      "format": "date"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_class", "claim_text", "evidence"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^C-\\d+$" },
          "claim_class": { "type": "string", "enum": ["E", "M", "N", "L", "D", "C", "U", "J"] },
          "risk": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"] },
          "claim_text": { "type": "string" },
          "interpretation": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "support_level"],
              "properties": {
                "source_id": { "type": "string", "pattern": "^S\\d+$" },
                "authority": { "type": "string", "enum": ["A1", "A2", "A3", "B1", "B2", "C1", "C2", "D1", "D2"] },
                "freshness": { "type": "string", "enum": ["current", "recent", "historical", "superseded", "unknown"] },
                "support_level": {
                  "type": "string",
                  "enum": ["direct", "strong_inference", "weak_inference", "context_only", "contradictory", "unsupported"]
                },
                "relation": {
                  "type": "string",
                  "enum": ["supports", "contradicts", "context_only"],
                  "description": "该来源对该 claim 的方向性关系：supports=支持 / contradicts=反证 / context_only=仅背景"
                },
                "locator": {
                  "type": "object",
                  "description": "来源原文定位：页码/节号/段落/引用片段哈希（quote_hash 可用 sha256(原文片段) 便于机器对账）",
                  "properties": {
                    "page": { "type": "integer" },
                    "section": { "type": "string" },
                    "paragraph": { "type": "integer" },
                    "quote_hash": { "type": "string" }
                  }
                }
              }
            }
          },
          "evidence_status": {
            "type": "string",
            "enum": ["verified", "supported", "partially_supported", "inferred", "contradicted", "unsupported", "unverified", "internal_confirm"]
          },
          "verdict": { "type": "string" }
        }
      }
    }
  }
}
