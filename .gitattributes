# 统一行尾：文本文件规范化到 LF，消除 CRLF/换行噪音
* text=auto

*.py  text eol=lf
*.md  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制保持原样
*.png binary
*.pdf binary
*.jpg binary
*.jpeg binary
*.gif binary
*.docx binary
*.pyc binary
